FROM artifactory.globaldevtools.bbva.com:443/public.ecr.aws-remote/docker/library/python:3.11-slim AS builder

ARG GENAI_ENVIRONMENT
ARG ARTIFACTORY_USER
ARG ARTIFACTORY_PASSWORD

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=America/Bogota \
    GENAI_ENVIRONMENT=${GENAI_ENVIRONMENT} \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    POETRY_VIRTUALENVS_CREATE=false \
    POETRY_VERSION=2.2.1 \
    POETRY_NO_INTERACTION=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /build

# Poetry, Artifactory credentials, and its download cache stay in this
# disposable stage and are never copied into the production image.
RUN python -m venv ${VIRTUAL_ENV} \
    && pip install --no-cache-dir \
        --index-url https://${ARTIFACTORY_USER}:${ARTIFACTORY_PASSWORD}@artifactory.globaldevtools.bbva.com/artifactory/api/pypi/gl-ai-genai-python-virtual/simple \
        poetry==${POETRY_VERSION}
COPY deploy/requirements/pyproject.worker.toml ./pyproject.toml
RUN poetry config http-basic.BBVARepo ${ARTIFACTORY_USER} ${ARTIFACTORY_PASSWORD} \
    && poetry install --only main --no-root

FROM artifactory.globaldevtools.bbva.com:443/public.ecr.aws-remote/docker/library/python:3.11-slim AS runtime

ARG GENAI_ENVIRONMENT

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=America/Bogota \
    GENAI_ENVIRONMENT=${GENAI_ENVIRONMENT} \
    APP_DIR=/code \
    PYTHONPATH=/code \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR ${APP_DIR}

COPY --from=builder ${VIRTUAL_ENV} ${VIRTUAL_ENV}
COPY --chown=www-data:www-data src ./src
USER www-data

CMD ["celery", "-A", "src.infrastructure.entrypoint.worker.celery.celery_app:app", "worker", "--loglevel=INFO"]
