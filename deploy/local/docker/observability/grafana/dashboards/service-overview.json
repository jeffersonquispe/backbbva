      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (aria_metrics_data_type, aria_metrics_level) (aria_metrics_rollup_drift)",
          "legendFormat": "{{aria_metrics_data_type}} / {{aria_metrics_level}}"
        }
