FROM python:3.11-slim AS builder

ARG GENAI_ENVIRONMENT=local

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=America/Bogota \
    GENAI_ENVIRONMENT=${GENAI_ENVIRONMENT} \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    POETRY_VIRTUALENVS_CREATE=false \
    POETRY_VERSION=2.2.1 \
    POETRY_NO_INTERACTION=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /build

# Poetry and its download cache exist only in the disposable builder stage.
RUN python -m venv ${VIRTUAL_ENV} \
    && pip install --no-cache-dir poetry==${POETRY_VERSION}
COPY deploy/requirements/pyproject.worker.toml ./pyproject.toml
RUN poetry install --only main --no-root

FROM python:3.11-slim AS runtime

ARG GENAI_ENVIRONMENT=local

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=America/Bogota \
    GENAI_ENVIRONMENT=${GENAI_ENVIRONMENT} \
    APP_DIR=/code \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR ${APP_DIR}

# xgboost's Linux wheel dynamically links against libgomp1.
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder ${VIRTUAL_ENV} ${VIRTUAL_ENV}
COPY --chown=www-data:www-data src ./src
USER www-data

CMD ["celery", "-A", "src.infrastructure.entrypoint.worker.celery.celery_app:app", "worker", "--loglevel=INFO"]
